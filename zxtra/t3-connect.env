# T3 Connect public configuration, as upstream's release builds embed it.
#
# Upstream's release workflow injects these at build time; a local build gets
# none, which turns `t3 connect` into a stub and hides T3 Connect sign-in in the
# app. Both build-and-install scripts export them before building. None of them
# is a secret: every official binary carries them in plain text, and these were
# read out of the v0.1.0 release.
T3CODE_RELAY_URL=https://relay.t3.codes
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r
